{
  "name": "web-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Free public AI chat platform with ads-funded backend (Phase 1: MVP skeleton)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:api dev:web",
    "dev:api": "npm --workspace @web-ai/api run dev",
    "dev:web": "npm --workspace @web-ai/web run dev",
    "build": "npm-run-all build:api build:web",
    "build:api": "npm --workspace @web-ai/api run build",
    "build:web": "npm --workspace @web-ai/web run build",
    "typecheck": "npm-run-all typecheck:api typecheck:web",
    "typecheck:api": "npm --workspace @web-ai/api run typecheck",
    "typecheck:web": "npm --workspace @web-ai/web run typecheck",
    "start": "npm --workspace @web-ai/api run start",
    "verify": "npm run build && node verify.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
