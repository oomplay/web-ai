# =============================================================================
# WEB-AI Backend - PRODUCTION environment template
# =============================================================================
# Copy this file to apps/api/.env on the production host and fill in the
# secret values from the operator's secret manager. NEVER commit .env.
#
# Topology:
#   Internet -> Cloudflare Edge (TLS) -> cloudflared -> 127.0.0.1:8787
#
# The Node API binds to 127.0.0.1:8787 only. It is NOT reachable from the
# public internet directly; only cloudflared (which runs on the same host)
# can talk to it. The Cloudflare Tunnel ingress is the only public path.
# =============================================================================

# --- Network ---
# API binds to this port on 127.0.0.1 only. The reverse proxy (cloudflared)
# in front of it terminates the public connection; this process never sees
# a non-loopback request.
PORT=8787

# --- CORS ---
# The public origin. Comma-separated if you serve multiple origins. Empty
# list and '*' are REJECTED at boot by index.ts#validateCorsConfig.
CORS_ORIGIN=https://chat.kiwicraft.in

# --- Reverse proxy / forwarded headers ---
# Number of trusted reverse-proxy hops in front of this service.
# In this topology, the only trusted hop is the Cloudflare Edge (which
# sets X-Forwarded-For with the real client IP). The local cloudflared
# daemon runs on the same host as the API and is NOT counted as a hop.
# 0 = the API is exposed directly to clients (no X-Forwarded-* trust).
# 1 = behind one reverse proxy (Cloudflare Edge).
# Do NOT set higher than the actual number of trusted proxies, or
# clients can spoof their IP and bypass per-IP rate limits.
TRUST_PROXY_HOPS=1

# --- AI provider ---
# Mock provider is OFF in production. The chat endpoint must serve real
# model responses; if no real gateway is configured, the registry will
# simply have zero models and /api/chat will 404 until you enable one.
# This avoids accidentally serving development-only mock responses to
# real users. See apps/api/.env.example for the full mock-provider notes.
MOCK_PROVIDER_ENABLED=false

# AI Gateway (Phase 2B). The provider is registered ONLY when ALL of
# the following hold:
#   - AI_GATEWAY_ENABLED=true
#   - AI_GATEWAY_BASE_URL is a valid https:// URL on AI_GATEWAY_ALLOWED_HOSTS
#   - AI_GATEWAY_API_KEY is set
#   - AI_GATEWAY_MODELS has at least one entry
# The SSRF guard refuses to fetch any host not on the allowlist, even
# if the base URL is misconfigured. Empty allowlist = provider rejected.
AI_GATEWAY_ENABLED=false
AI_GATEWAY_BASE_URL=https://ai-gateway.kiwicraft.in/v1
# Treat AI_GATEWAY_API_KEY as a secret. Source it from the operator's
# secret manager (Vault, AWS Secrets Manager, Doppler, etc.). Never
# paste a real key into this file or commit it.
AI_GATEWAY_API_KEY=
# Comma-separated allowlist of upstream model ids the client may use.
# Anything outside this list returns 404 from /api/chat.
AI_GATEWAY_MODELS=
# Hostnames the base URL is allowed to point at. SSRF guard enforces
# this even if the operator mistypes the URL. Set to the gateway host
# only. Empty = no provider can register.
AI_GATEWAY_ALLOWED_HOSTS=ai-gateway.kiwicraft.in
# Per-request outbound timeout in ms.
AI_GATEWAY_TIMEOUT_MS=30000

# --- Safety layer (Phase 2A) ---
# All knobs default to a conservative "public free chat" baseline. Only
# override with a clear operational reason.
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30
MODELS_RATE_LIMIT_WINDOW_MS=60000
MODELS_RATE_LIMIT_MAX=120
MAX_CONCURRENT_STREAMS_PER_IP=3
MAX_CONCURRENT_REQUESTS_PER_IP=10
MAX_MESSAGES=100
MAX_MESSAGE_LENGTH=32000
MAX_TOTAL_CHARS=200000
SSE_IDLE_TIMEOUT_MS=30000
SSE_MAX_DURATION_MS=120000
SSE_KEEPALIVE_MS=15000
PROVIDER_TIMEOUT_MS=30000
