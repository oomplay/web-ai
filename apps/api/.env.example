# --- Backend ---
# Port the API binds to. Bind to 127.0.0.1 in production (set in command
# invocation) and put a reverse proxy in front for TLS termination.
PORT=8787

# --- CORS ---
# Comma-separated list of EXACT origins allowed to call this API.
# Wildcard '*' is REJECTED. Each entry must be a literal origin:
# scheme + host (+ optional port), e.g. https://app.example.com
# For local development:
CORS_ORIGIN=http://localhost:5173

# --- Reverse proxy / forwarded headers ---
# Number of trusted reverse-proxy hops in front of this service.
# 0 = the API is exposed directly to clients (no X-Forwarded-* trust).
# 1 = behind one reverse proxy (nginx, Cloudflare, ELB, ...).
# Setting this > 0 enables Express `trust proxy` so `req.ip` and rate
# limiting see the real client IP, not the proxy's. Do NOT set higher
# than the actual number of proxies, or clients can spoof their IP.
TRUST_PROXY_HOPS=0

# --- Mock provider ---
# Default: enabled. Phase 2A has no real AI provider wired in, so this is
# the only source of chat responses. Disable only when you have a Phase 2B
# real provider configured below.
MOCK_PROVIDER_ENABLED=true

# --- AI Gateway (Phase 2B: KiwiCraft) ---
# This is the only real AI provider wired into WEB-AI for now. It talks
# OpenAI-compatible chat completions at:
#   {AI_GATEWAY_BASE_URL}/chat/completions
# The provider is registered ONLY when ALL of the following hold:
#   - AI_GATEWAY_ENABLED=true
#   - AI_GATEWAY_BASE_URL is a valid https:// URL on AI_GATEWAY_ALLOWED_HOSTS
#   - AI_GATEWAY_API_KEY is set
#   - AI_GATEWAY_MODELS has at least one entry
# The model allowlist is the *only* way to expose upstream models: the
# client cannot pass an arbitrary model id to /api/chat. Whitelist only
# the model ids the operator has actually validated with the gateway.
AI_GATEWAY_ENABLED=false
AI_GATEWAY_BASE_URL=https://ai-gateway.kiwicraft.in/v1
AI_GATEWAY_API_KEY=
# Comma-separated allowlist of upstream model ids. The frontend sees
# exactly these ids in /api/models; anything else returns 404.
AI_GATEWAY_MODELS=
# Comma-separated allowlist of hostnames the base URL is allowed to
# point at. SSRF guard: even if AI_GATEWAY_BASE_URL is misconfigured to
# localhost / 169.254.169.254 / 10.x / 192.168.x, the request is
# refused before fetch is called.
AI_GATEWAY_ALLOWED_HOSTS=ai-gateway.kiwicraft.in
# Per-request outbound timeout in ms. Combined with the client abort
# signal: whichever fires first wins.
AI_GATEWAY_TIMEOUT_MS=30000

# --- Safety layer (Phase 2A) ---
# All knobs default to a conservative "public free chat" baseline. Override
# only with a clear operational reason.

# Per-IP sliding-window rate limit for POST /api/chat.
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

# Per-IP sliding-window rate limit for GET /api/models.
MODELS_RATE_LIMIT_WINDOW_MS=60000
MODELS_RATE_LIMIT_MAX=120

# Per-IP concurrent in-flight caps.
MAX_CONCURRENT_STREAMS_PER_IP=3
MAX_CONCURRENT_REQUESTS_PER_IP=10

# Input bounds for POST /api/chat body. Reject before resolveProvider().
MAX_MESSAGES=100
MAX_MESSAGE_LENGTH=32000
MAX_TOTAL_CHARS=200000

# SSE lifecycle (per stream).
SSE_IDLE_TIMEOUT_MS=30000
SSE_MAX_DURATION_MS=120000
SSE_KEEPALIVE_MS=15000

# Outbound provider request budget (used by Phase 2B).
PROVIDER_TIMEOUT_MS=30000

