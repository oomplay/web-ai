# =============================================================================
# WEB-AI Frontend - PRODUCTION environment template
# =============================================================================
# Vite reads this file at BUILD time. The values are inlined into the
# static bundle. After changing this file you MUST rerun `npm run build`.
# Copy to apps/web/.env on the production host before `npm run build`.
# =============================================================================

# Public origin of the deployed app. Used as the API base URL. The bundle
# calls https://chat.kiwicraft.in/api/* directly; there is no dev-server
# proxy in production.
VITE_API_BASE_URL=https://chat.kiwicraft.in

# --- Ads (Phase 3) ---
# Which ad backend renders inside the <AdSlot> containers.
#   placeholder (default) - labelled dashed box, zero network calls.
#   adsense               - real AdSense; falls back to placeholder per
#                           slot when the client/slot id is missing or
#                           when the script is blocked.
#   none                  - ad-free build; slots reserve layout space
#                           but render nothing.
# Production starts in `placeholder` mode. Switch to `adsense` only after
# the operator completes docs/ADSENSE_REVIEW_CHECKLIST.md.
VITE_ADS_PROVIDER=placeholder

# AdSense publisher client id, e.g. ca-pub-1234567890123456.
# Leave empty until AdSense review is complete; the AdsenseAd provider
# will render the placeholder instead.
VITE_ADSENSE_CLIENT=

# AdSense slot id for the bottom placement. Empty = placeholder only.
VITE_ADSENSE_SLOT_BOTTOM=

# Non-Personalized Ads. true = NPA mode (no personalisation cookies).
# Recommended for GDPR / child-directed / regulated traffic. See
# docs/ADSENSE_REVIEW_CHECKLIST.md section 7 for the consent obligations.
VITE_ADSENSE_NPA=false
