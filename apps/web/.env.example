# URL of the backend API
VITE_API_BASE_URL=http://localhost:8787

# --- Ads (Phase 3) ---
# Which ad backend renders inside the bottom panel (BottomAdPanel,
# the product's only ad placement).
#   placeholder (default) — labelled house-ad card, zero network calls.
#   adsense               — real AdSense; falls back to the placeholder
#                           when the client/slot id is missing or when
#                           the script is blocked.
#   none                  — ad-free build; the panel shows the provider
#                           disclosure only.
VITE_ADS_PROVIDER=placeholder

# AdSense publisher client id, e.g. ca-pub-1234567890123456.
# Leave empty in dev; AdsenseAd falls back to the placeholder and
# warns once. Never commit a real value.
VITE_ADSENSE_CLIENT=

# AdSense slot id for the bottom placement. Leave empty to render the
# placeholder instead.
VITE_ADSENSE_SLOT_BOTTOM=

# Non-Personalized Ads. true = NPA mode (no personalisation cookies).
# Recommended for GDPR / child-directed / regulated traffic. See
# PHASE_3_PLAN.md §7.3 for the operator's consent obligations.
VITE_ADSENSE_NPA=false
