# URL of the backend API
VITE_API_BASE_URL=http://localhost:8787

# --- Ads (Phase 3) ---
# Which ad backend renders inside the <AdSlot> containers.
#   placeholder (default) — labelled dashed box, zero network calls.
#   adsense               — reserved for milestone 3.3; falls back to
#                           the placeholder (with one console warning)
#                           until the AdSense provider is wired.
#   none                  — ad-free build; slots reserve layout space
#                           but render nothing.
VITE_ADS_PROVIDER=placeholder
